# SPDX-License-Identifier: AGPL-3.0-or-later
# Copy to .env and replace every value. Use hex values as below – they go into connection URLs unescaped.
#   POSTGRES_PASSWORD        superuser, for administration only: `openssl rand -hex 24`
#   KERNOID_OWNER_PASSWORD   owner of the schema, used by the migrate step only: `openssl rand -hex 24`
#   KERNOID_APP_PASSWORD     runtime role kernoid serves with: `openssl rand -hex 24`
#   KERNOID_MAIN_KEY         64 hex characters: `openssl rand -hex 32` – encrypts all content; without it, content
#                            cannot be read again: keep a copy apart from the server
#   GARAGE_RPC_SECRET        64 hex characters: `openssl rand -hex 32`
#   S3_ACCESS_KEY_ID         "GK" and 24 hex characters: `echo GK$(openssl rand -hex 12)`
#   S3_SECRET_KEY            64 hex characters: `openssl rand -hex 32`
POSTGRES_PASSWORD=change-me
KERNOID_OWNER_PASSWORD=change-me
KERNOID_APP_PASSWORD=change-me
KERNOID_MAIN_KEY=change-me
GARAGE_RPC_SECRET=change-me
S3_ACCESS_KEY_ID=change-me
S3_SECRET_KEY=change-me

# Names. KERNOID_HOST serves the instance (login, API); MAIL_HOST is the name the MX records point to and the one
# mail programs connect to – it must differ from KERNOID_HOST. The mail domain itself (the part after @) is set up with
# the CLI, see README.md; NOTIFICATION_FROM must be an address on it.
KERNOID_HOST=test.kernoid.dev
MAIL_HOST=mail.test.kernoid.dev
NOTIFICATION_FROM=noreply@test.kernoid.dev

# Certificates (Caddy). ACME_CA_DIR is the CA's directory URL without "https://" and with "/" as "-": Caddy keeps the
# certificates under that name. For first tries, Let's Encrypt's staging CA has higher limits (its certificates are
# not trusted by clients):
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
#   ACME_CA_DIR=acme-staging-v02.api.letsencrypt.org-directory
ACME_EMAIL=change-me@example.org
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
ACME_CA_DIR=acme-v02.api.letsencrypt.org-directory

# The image (README.md, Updating): CI's newest from main unless set.
#KERNOID_IMAGE=ghcr.io/kernoid/kernoid:main

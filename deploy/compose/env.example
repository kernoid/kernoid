# SPDX-License-Identifier: AGPL-3.0-or-later
# Copy to .env and replace every value. Use hex values as below – they go into connection URLs unescaped.
#   POSTGRES_PASSWORD        superuser, for administration only: `openssl rand -hex 24`
#   KERNOID_OWNER_PASSWORD   owner of the schema, used by the migrate step only: `openssl rand -hex 24`
#   KERNOID_APP_PASSWORD     runtime role kernoid serves with: `openssl rand -hex 24`
#   KERNOID_MAIN_KEY         64 hex characters: `openssl rand -hex 32` – encrypts all content; without it, content
#                            cannot be read again: keep a copy apart from the server
#   GARAGE_RPC_SECRET        64 hex characters: `openssl rand -hex 32`
#   S3_ACCESS_KEY_ID         "GK" and 24 hex characters: `echo GK$(openssl rand -hex 12)`
#   S3_SECRET_KEY            64 hex characters: `openssl rand -hex 32`
POSTGRES_PASSWORD=change-me
KERNOID_OWNER_PASSWORD=change-me
KERNOID_APP_PASSWORD=change-me
KERNOID_MAIN_KEY=change-me
GARAGE_RPC_SECRET=change-me
S3_ACCESS_KEY_ID=change-me
S3_SECRET_KEY=change-me

# The image: the release unless set – e.g. kernoid:local, built from this checkout with `docker build -t kernoid:local ../..`.
#KERNOID_IMAGE=ghcr.io/kernoid/kernoid:0.2.0

# The virus scan module: true, and start with `docker compose --profile clamav up -d` (docs: Modules).
#KERNOID_CLAMAV=true

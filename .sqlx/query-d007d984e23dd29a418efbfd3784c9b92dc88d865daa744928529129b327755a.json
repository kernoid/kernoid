  "db_name": "PostgreSQL",
  "query": "SELECT transaction_id::text::int8 AS \"transaction_id!\", position, instance_id, owner, aggregate_type,\n                  aggregate_id, sequence, event_type, revision, payload, creator, created_at\n           FROM events\n           WHERE (transaction_id, position) > ($1::int8::text::xid8, $2)\n             AND transaction_id < pg_snapshot_xmin(pg_current_snapshot())\n           ORDER BY transaction_id, position\n           LIMIT $3",

{
  "db_name": "PostgreSQL",
  "query": "SELECT k.fingerprint, k.kind, k.public_key FROM addresses ad\n             JOIN accounts a ON a.id = ad.account_id JOIN tenants t ON t.id = a.tenant_id\n             JOIN openpgp_keys k ON k.account_id = a.id AND k.retired_at IS NULL\n             WHERE ad.address = $1 AND t.instance_id = $2 AND a.active",

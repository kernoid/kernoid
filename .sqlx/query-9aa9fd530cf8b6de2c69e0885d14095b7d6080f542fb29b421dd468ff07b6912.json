{
  "db_name": "PostgreSQL",
  "query": "SELECT l.id, l.owner_id, l.node_id, l.password_hash IS NOT NULL AS \"needs_password!\", l.may_read, l.may_add\n             FROM file_links l\n             JOIN accounts a ON a.id = l.owner_id\n             JOIN tenants t ON t.id = a.tenant_id\n             WHERE l.token_hash = $1 AND t.instance_id = $2 AND a.active AND t.active\n               AND (l.expires_at IS NULL OR l.expires_at > now())",

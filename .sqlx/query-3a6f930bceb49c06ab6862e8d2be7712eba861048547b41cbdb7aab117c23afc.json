  "query": "SELECT id, account_id, checks, created_at, expires_at, host(client_address) AS \"client_address?\",\n                      user_agent\n               FROM sessions\n               WHERE account_id = $1 AND terminated_at IS NULL AND expires_at > now()\n               ORDER BY created_at DESC",

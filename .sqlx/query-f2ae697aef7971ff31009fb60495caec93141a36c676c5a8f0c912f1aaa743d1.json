  "query": "SELECT s.created_at, s.checks, s.expires_at FROM sessions s\n             JOIN accounts a ON a.id = s.account_id JOIN tenants t ON t.id = s.tenant_id\n             WHERE s.id = $1 AND s.terminated_at IS NULL AND s.expires_at > now() AND a.active AND t.active",

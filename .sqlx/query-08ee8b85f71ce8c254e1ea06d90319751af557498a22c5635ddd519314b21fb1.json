  "query": "SELECT t.instance_id, a.tenant_id, a.id, a.display_name, coalesce(a.primary_address, a.username, a.email, '') AS \"primary_address!\", a.primary_address IS NOT NULL AS \"native!\", a.active, a.kind\n             FROM accounts a JOIN tenants t ON t.id = a.tenant_id\n             WHERE ($1::text IS NOT NULL AND a.id = (SELECT account_id FROM addresses WHERE address = $1))\n                OR ($2::uuid IS NOT NULL AND a.id = $2)",

  "query": "SELECT m.tenant_id, m.modseq, m.used_bytes, coalesce(a.mail_quota, t.default_mail_quota) AS mail_quota\n             FROM mail_accounts m JOIN accounts a ON a.id = m.account_id JOIN tenants t ON t.id = a.tenant_id\n             WHERE m.account_id = $1 FOR UPDATE OF m",

  "query": "SELECT f.tenant_id, f.modseq, f.used_bytes, coalesce(a.files_quota, t.default_files_quota) AS files_quota\n             FROM file_accounts f JOIN accounts a ON a.id = f.account_id JOIN tenants t ON t.id = a.tenant_id\n             WHERE f.account_id = $1",

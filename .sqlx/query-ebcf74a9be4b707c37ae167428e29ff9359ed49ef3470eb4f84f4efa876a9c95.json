{
  "db_name": "PostgreSQL",
  "query": "SELECT em.uid, em.email_id,\n                      EXISTS (SELECT 1 FROM email_mailboxes o WHERE o.email_id = em.email_id AND o.mailbox_id <> em.mailbox_id) AS \"elsewhere!\"\n               FROM email_mailboxes em JOIN emails e ON e.id = em.email_id\n               WHERE em.mailbox_id = $1 AND (NOT $2 OR '$deleted' = ANY(e.keywords)) ORDER BY em.uid",

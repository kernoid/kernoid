{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.credential, t.instance_id, a.tenant_id, a.display_name, coalesce(a.primary_address, a.username, a.email, '') AS \"primary_address!\", a.primary_address IS NOT NULL AS \"native!\",\n                      (a.active AND t.active) AS \"active!\"\n               FROM account_passkeys p JOIN accounts a ON a.id = p.account_id JOIN tenants t ON t.id = a.tenant_id\n               WHERE p.credential_id = $1 AND p.account_id = $2",

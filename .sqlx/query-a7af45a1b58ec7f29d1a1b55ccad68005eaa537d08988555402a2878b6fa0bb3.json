  "query": "SELECT r.id, a.name, r.scopes, r.prompt, r.max_age, r.expires_at\n             FROM auth_requests r JOIN applications a ON a.id = r.application_id\n             WHERE r.id = $1 AND r.instance_id = $2 AND r.session_id IS NULL AND r.expires_at > now()",

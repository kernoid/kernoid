{
  "name": "@kernoid/app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "kernoid's web app – mail, calendar, contacts and files: served by kernoid at /app",
  "type": "module",
  "scripts": {
    "api": "openapi-typescript ../../docs/_data/openapi.json -o src/admin/api-types.ts",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@kernoid/sdk": "workspace:*",
    "@lucide/svelte": "1.57.0",
    "openapi-fetch": "0.17.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "openapi-typescript": "7.13.0",
    "svelte-check": "4.7.6"
  }
}
